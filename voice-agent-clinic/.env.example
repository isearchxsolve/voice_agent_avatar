# Copy to .env and populate only the services you enable. Never expose this file in a browser bundle.
VOICE_AGENT_API_KEY=
VOICE_LLM_PROVIDER=gemini
VOICE_TTS_PROVIDER=f5_tts
VOICE_STT_PROVIDER=local_whisper
VOICE_AVATAR_PROVIDER=liveportrait
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
F5_TTS_REF_AUDIO=assets/clinic_voice.wav
F5_TTS_DEVICE=cpu
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
LIVEPORTRAIT_DEVICE=cpu
LIVEPORTRAIT_CHECKPOINT_DIR=
LIVEPORTRAIT_REF_IMAGE=
KAGGLE_VOICE_BRIDGE_URL=
KAGGLE_AVATAR_BRIDGE_URL=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=12345
CRM_WEBHOOK_URL=
CRM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CLINIC_TIMEZONE=America/New_York
